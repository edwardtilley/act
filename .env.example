SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,actcanadian.com,www.actcanadian.com,.up.railway.app
DATABASE_URL=sqlite:///db.sqlite3
PORT=5105

# ── Hub shared-services credentials (see AGENTS.md §11) ────────────────────
# Two directions of trust:
#
# (store -> hub) This store's OWN identity, UNIQUE per store. Used by the
#   store's IDE agent for hub MCP calls (change_request_submit, health_check,
#   …). Minted per store by the hub; hash-only at rest on the hub.
STORE_AI_DEVELOPER_API_KEY=

# (hub -> store) Hub-issued role keys injected INTO this store by the hub
#   (same value across all the owner's stores). The store consumes them to
#   call hub shared services and NEVER rotates them. Delivered via the hub's
#   .env injection (change request #13); do NOT commit real values.
#
# Marketing key: hub marketing MCP tools only (marketing_campaign_* /
# marketing_entry_* / marketing_sweep_sheets).
HUB_MARKETING_API_KEY=

# SysOp key: hub sysop tools (health_check, backup/restore, logs).
HUB_SYSOP_API_KEY=

# Optional store-scoped keys (only if the store runs a training or order
# agent): STORE_ORDER_API_KEY, STORE_TRAINING_API_KEY.

# Hub MCP gateway URL (default http://ubuntu:5001/mcp).
# HUB_MCP_URL=http://ubuntu:5001/mcp
