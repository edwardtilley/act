SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,actcanadian.com,www.actcanadian.com,.up.railway.app
DATABASE_URL=sqlite:///db.sqlite3
PORT=5105

# ── Hub shared-services credentials (see AGENTS.md §11) ────────────────────
# Hub-issued role keys this store consumes to call hub shared services.
# Values are delivered by the hub's .env injection — do NOT commit real values.
#
# AI developer key: this store's IDE agent key for hub MCP calls
# (change_request_submit, health_check, …). Auto-minted per store by the hub
# scaffold; hash-only at rest on the hub.
HUB_AI_DEVELOPER_API_KEY=

# Marketing key: lets the marketing agent publish via hub marketing MCP tools
# only. Per-store .env injection is the subject of hub change request #13.
HUB_MARKETING_API_KEY=

# NOTE: HUB_SYSOP_API_KEY is NOT a store .env var. SysOp keys are user-scoped
# and live in the hub's encrypted credentials vault (user_credentials); the
# store never holds or rotates them. See AGENTS.md §11 / ARCHITECTURE-KEYS-AGENTS.md.

# Optional store-scoped keys (vault-backed; only if the store runs a training
# or order agent): STORE_ORDER_API_KEY, STORE_TRAINING_API_KEY.
